# Runtime
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Temporary bootstrap mode: no login or database needed. All requests are treated as a demo admin
# unless they provide x-user-* headers. Do not use with real user data.
AUTH_MODE=demo

# Optional persistent storage. Without it, data resets when the server or Vercel function restarts.
DATABASE_URL=

# Future institutional OpenID Connect / JWT validation. Set AUTH_MODE=oidc when these are ready.
AUTH_ISSUER=https://identity.example.edu/
AUTH_AUDIENCE=iiml-sports-api
AUTH_JWKS_URI=https://identity.example.edu/.well-known/jwks.json

# Optional: required only when the cron/email feature is enabled later.
CRON_SECRET=replace-me

# Optional email delivery webhook. Without it, notifications remain in the outbox.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
