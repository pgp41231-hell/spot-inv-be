# Runtime
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Auth and equipment QR configuration. Use a long random QR secret.
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SEED_PASSWORD=
QR_TOKEN_SECRET=
QR_TOKEN_TTL_HOURS=6

# Required for the Supabase equipment module and persistent portal data.
# For Supabase, use the Transaction pooler URL (port 6543) here.
# If installed through the Vercel Marketplace, POSTGRES_URL is supplied automatically instead.
DATABASE_URL=

# Use a direct connection (or POSTGRES_URL_NON_POOLING from the Vercel integration)
# when running migrations. Do not commit a real URL.
DIRECT_DATABASE_URL=

# Optional future institutional OpenID Connect / JWT validation.
AUTH_ISSUER=https://identity.example.edu/
AUTH_AUDIENCE=iiml-sports-api
AUTH_JWKS_URI=https://identity.example.edu/.well-known/jwks.json

# Optional: required only when the cron/email feature is enabled later.
CRON_SECRET=replace-me

# Optional email delivery webhook. Without it, notifications remain in the outbox.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
