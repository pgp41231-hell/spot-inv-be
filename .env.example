# Local runtime
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Required for persistent production data. A pooled Neon/Vercel Marketplace URL is recommended.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Institutional OpenID Connect / JWT validation
AUTH_ISSUER=https://identity.example.edu/
AUTH_AUDIENCE=iiml-sports-api
AUTH_JWKS_URI=https://identity.example.edu/.well-known/jwks.json

# Local-only authentication. Never enable this in production.
ALLOW_DEV_AUTH=true

# Protects scheduled reminder processing.
CRON_SECRET=replace-me

# Optional email delivery webhook. Without it, notifications remain in the outbox.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
